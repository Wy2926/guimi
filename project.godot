; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="烬庭 · EMBER YARD"
config/description="封神肉鸽：人物神通、法宝组合、属性异常、天命词条与终极进化。"
run/main_scene="res://scenes/arena.tscn"
run/max_fps=120
config/features=PackedStringArray("4.7", "Forward Plus")

[audio]

default_bus_layout="res://default_bus_layout.tres"

[display]

window/size/viewport_width=1600
window/size/viewport_height=1000
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/size/min_width=960
window/size/min_height=600
window/vsync/vsync_mode=0

