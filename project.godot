[layer_names]

3d_physics/layer_1="Stage"
3d_physics/layer_2="Fighter"
3d_physics/layer_3="Target"

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=16
3d/physics_engine="GodotPhysics3D"

[rendering]

anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.035, 0.05, 0.065, 1)
lights_and_shadows/positional_shadow/atlas_size=2048
